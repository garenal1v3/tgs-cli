FROM golang:1.26-bookworm

ARG GOLANGCI_LINT_VERSION=v2.12.2
ARG HUGO_VERSION=0.158.0
ARG NODE_MAJOR=22

# golangci-lint
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh | sh -s -- -b /usr/local/bin ${GOLANGCI_LINT_VERSION}

# Hugo extended (arch-aware)
RUN ARCH=$(dpkg --print-architecture) \
    && curl -sSfL "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-${ARCH}.deb" -o /tmp/hugo.deb \
    && dpkg -i /tmp/hugo.deb && rm /tmp/hugo.deb

# Node.js (for PostCSS/autoprefixer)
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN cd docs && npm install postcss postcss-cli autoprefixer
